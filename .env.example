# PyroGuard 2D 서버 설정 — 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 깃에 올라가지 않는다)

# 관제실 운영자 로그인 비밀번호
OPERATOR_PASSWORD=
# 세션 쿠키 서명 키 — 16자 이상 무작위 문자열 (예: openssl rand -base64 32)
SESSION_SECRET=
# 119 소방관 OTP — 6자리 숫자. 소방대와 별도 경로로 공유한다
EMERGENCY_OTP=

# 선택
# APPROVAL_TTL_MINUTES=30          # 119 승인 유지 시간 (분)
# SESSION_TTL_HOURS=12             # 운영자 로그인 유지 시간
# CORS_ALLOWED_ORIGINS=            # 다른 출처에서 API 를 부를 곳 (쉼표 구분). 비우면 같은 출처만
# DATA_DIR=.data                   # 센서 배치(sensors.json)·감사 로그(audit.log)·로그아웃한 세션 저장 폴더
# TRUST_PROXY_HOPS=0               # 앞에 둔 nginx·로드밸런서 수. 1 이상이면 그 프록시가 붙인 X-Forwarded-For 칸으로
#                                  # 로그인 잠금·감사 로그의 주소를 잡는다. 0 이면 헤더를 믿지 않는다(위조 가능해서)
